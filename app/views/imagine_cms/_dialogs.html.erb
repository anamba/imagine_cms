<div id="properties_dialog" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="properties_dialog_title">
  <div class="imagine-cms-dialog__panel imagine-cms-dialog__panel--properties">
    <div class="imagine-cms-dialog__header">
      <h2 id="properties_dialog_title" data-imagine-dialog-title>Page Properties</h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="cancelEditProperties();" aria-label="Close">×</button>
    </div>
    <div id="properties_dialog_content" class="imagine-cms-dialog__content"></div>
  </div>
</div>

<div id="page_browser_dialog" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="page_browser_dialog_title">
  <div class="imagine-cms-dialog__panel">
    <div class="imagine-cms-dialog__header">
      <h2 id="page_browser_dialog_title" data-imagine-dialog-title>Select Page</h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="hideDojoDialog('page_browser_dialog');" aria-label="Close">×</button>
    </div>
    <div class="imagine-cms-dialog__content">
      <div id="page_browser" class="imagine-cms-page-browser">Loading...</div>
      <div class="imagine-cms-dialog__footer">
        <input id="page_browser_selection" type="text" class="form imagine-cms-dialog__input" />
        <button type="button" onclick="closePageBrowser(); return false;" class="form_button">Select</button>
      </div>
    </div>
  </div>
</div>

<div id="insert_image_dialog" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="insert_image_dialog_title">
  <div class="imagine-cms-dialog__panel imagine-cms-dialog__panel--media">
    <div class="imagine-cms-dialog__header">
      <h2 id="insert_image_dialog_title" data-imagine-dialog-title>Insert Image</h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="cancelInsertImage();" aria-label="Close">×</button>
    </div>
    <div id="insert_image_dialog_content" class="imagine-cms-dialog__content"></div>
  </div>
</div>

<div id="insert_file_dialog" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="insert_file_dialog_title">
  <div class="imagine-cms-dialog__panel imagine-cms-dialog__panel--media">
    <div class="imagine-cms-dialog__header">
      <h2 id="insert_file_dialog_title" data-imagine-dialog-title>Create Download Link</h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="cancelInsertFile();" aria-label="Close">×</button>
    </div>
    <div id="insert_file_dialog_content" class="imagine-cms-dialog__content"></div>
  </div>
</div>

<div id="select_thumbnail_dialog" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="select_thumbnail_dialog_title">
  <div class="imagine-cms-dialog__panel imagine-cms-dialog__panel--media">
    <div class="imagine-cms-dialog__header">
      <h2 id="select_thumbnail_dialog_title" data-imagine-dialog-title>Select Thumbnail</h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="cancelSelectThumbnail();" aria-label="Close">×</button>
    </div>
    <div id="select_thumbnail_dialog_content" class="imagine-cms-dialog__content"></div>
  </div>
</div>

<div id="gallery_dialog" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="gallery_dialog_title">
  <div class="imagine-cms-dialog__panel imagine-cms-dialog__panel--media">
    <div class="imagine-cms-dialog__header">
      <h2 id="gallery_dialog_title" data-imagine-dialog-title>Gallery</h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="hideDojoDialog('gallery_dialog');" aria-label="Close">×</button>
    </div>
    <div id="gallery_dialog_content" class="imagine-cms-dialog__content"></div>
  </div>
</div>

<div id="preview_cover" onclick="return false;" style="display: none;"></div>
<div id="dialog-temp"></div>

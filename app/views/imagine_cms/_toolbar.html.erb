<%- if params[:action] != 'preview_template' -%>
  <%- if [ 'cms/content', 'manage/cms_pages' ].include?(controller.controller_path) -%>
    <%- if is_editing_page? && is_logged_in_user? -%>
      <%= render template: '/manage/cms_pages/toolbar_edit' %>
    <%- elsif @pg -%>
      <div id="imagine-cms-toolbar-host" hidden data-toolbar-url="<%= url_for controller: '/manage/cms_pages', action: 'toolbar_preview', id: @pg, version: params[:version] %>"></div>
    <%- end -%>
  <%- end -%>
<%- end -%>

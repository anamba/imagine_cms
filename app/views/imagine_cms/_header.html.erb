<%#= javascript_tag 'var djConfig = { isDebug: true };' %>

<script>
    function readCookie(name) {
        var ca = document.cookie.split(';');
        for (var i=0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') c = c.substring(1, c.length);
            if (c.indexOf(name+'=') == 0) return c.substring((name+'=').length, c.length);
        }
        return null;
    }
    
    function loggedIn() {
        return readCookie('user_auth_status') == 'authenticated';
    }

    var load_imagine_controls = loggedIn() || <%= ImagineCms.use_legacy_dojo_editor && @load_dojo ? 'true' : 'false' %>;

    if (load_imagine_controls) {
        document.writeln('<link href="/assets/imagine_controls.css" media="screen" rel="stylesheet" type="text/css" />')
    }

    function imagineCmsInsertToolbar(host, html) {
        if (!host || !html || html.indexOf('imagine-cms-toolbar') === -1) return;

        var wrap = document.createElement('div');
        wrap.innerHTML = html;
        var scripts = [];
        wrap.querySelectorAll('script').forEach(function(script) {
            scripts.push(script.textContent);
            script.parentNode.removeChild(script);
        });
        while (wrap.firstChild) {
            host.parentNode.insertBefore(wrap.firstChild, host);
        }
        host.parentNode.removeChild(host);
        scripts.forEach(function(code) {
            var script = document.createElement('script');
            script.textContent = code;
            document.body.appendChild(script);
        });
    }

    // Cached public HTML never includes the toolbar (revision history must not leak).
    // If the auth cookie is set, load it from the session-protected endpoint.
    function imagineCmsLoadPreviewToolbar() {
        if (!loggedIn()) return;
        var host = document.getElementById('imagine-cms-toolbar-host');
        if (!host || document.getElementById('imagine_cms-toolbar')) return;
        var url = host.getAttribute('data-toolbar-url');
        if (!url) return;

        fetch(url, {
            credentials: 'same-origin',
            headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
        }).then(function(response) {
            return response.ok ? response.text() : '';
        }).then(function(html) {
            imagineCmsInsertToolbar(host, html);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', imagineCmsLoadPreviewToolbar);
    } else {
        imagineCmsLoadPreviewToolbar();
    }
</script>
<%- if ImagineCms.use_legacy_dojo_editor -%>
  <script defer type="text/javascript">
      var load_dojo = false;
      if (<%= @load_dojo || 'false' %>) {
        load_dojo = true;
      }

      if (loggedIn() || load_dojo) {
          document.writeln('<scr' + 'ipt src="/assets/dojo/dojo.js" type="text/javascript"></scr' + 'ipt>');
      }
  </script>
  <script defer type="text/javascript">
      if (loggedIn()) {
          dojo.require("dojo.widget.Editor2");
          dojo.require("dojo.widget.Editor2Plugin.TableOperation");
      }
  </script>
<%- end -%>

<%= stylesheet_link_tag "cms_dialog", media: "screen" %>

<script>
  window.ImagineCmsConfig = {
    toolbarStickyOffset: <%= ImagineCms.toolbar_sticky_offset %>,
    toolbarStickyOffsetMobile: <%= ImagineCms.toolbar_sticky_offset_mobile || 'null' %>
  };
</script>

<%- for feed in [].concat(@rss_feeds || []) -%>
  <%= auto_discovery_link_tag(:rss, { controller: '/cms/content', action: 'rss_feed', page_id: @pg.id, page_list_name: feed }, title: feed) if @pg && @pg.id %>
<%- end -%>

<%=raw @cms_head %>
<%=raw @pg.html_head if @pg && @pg.respond_to?(:html_head) %>

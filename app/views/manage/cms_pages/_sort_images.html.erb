<p>Drag the images until they are in the desired order. Click <strong>save</strong> when finished.</p>

<div id="images" style="margin-bottom: 10px; padding: 10px; border: 2px dashed #555;">
  <%= render :partial => 'image_draggable', :collection => @images, :locals => { :path => @pg.path, :gallery_id => params[:gallery_id] } %>
  <br style="clear: both;" />
</div>

<script>
  jQuery('#images').sortable({
    items: 'div[id^="image_"]',
    update: function () {
      var params = new URLSearchParams();
      jQuery('#images div[id^="image_"]').each(function () {
        params.append('images[]', this.id.replace(/^image_/, ''));
      });
      imagineCmsRemoteRequest('<%= url_for(action: 'sort_images', id: @pg, gallery_id: params[:gallery_id]) %>', { method: 'POST', body: params });
    }
  });
</script>

<%= form_tag({ action: 'sort_images_save', id: @pg, gallery_id: params[:gallery_id] }, data: { remote: true, update: 'gallery_container' }) do -%>
  <%= submit_tag "Save order" %> or <%= link_to "cancel",
                                             { action: 'gallery_management', id: @pg, gallery_id: params[:gallery_id] },
                                             data: { remote: true, update: 'gallery_container' } %>
<%- end -%>

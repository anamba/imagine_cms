<script type="text/javascript">
  attrlist = new Array(<%= @attrs.size %>)
  <%- @attrs.each_with_index do |attr, i| -%>
  attrlist[<%= i %>]="<%=j attr %>";
  <%- end -%>
  
  taglist = new Array(<%= @taglist.size %>)
  <%- @taglist.each_with_index do |tag, i| -%>
  taglist[<%= i %>]="<%=j tag %>";
  <%- end -%>
  
  jQuery(document).ready(function () {
    jQuery('#tags').tagit({ availableTags: taglist, allowSpaces: true, caseSensitive: false, removeConfirmation: true, autocomplete: { delay: 0, minLength: 0 } });
  });
</script>

<div id="save_errors" class="error"></div>

<%= form_remote_tag url: { action: 'edit_page', id: @pg },
                    loading: "$('btn_save').disabled = true; $('btn_save').value = 'Saving...';" do %>
<table id="dlg-page-properties" class="imagine-cms-properties-form">
  <col width="120"><col width="*"><col width="5">
<%- if @pg.id != 1 -%>
  <tr id="cms_page-form-name-row">
    <td class="imagine-cms-properties-form__label">Name (for URL):</td>
    <td>
      <%= text_field :pg, :name, class: 'form', style: 'margin-bottom: 0; width: 150px', onchange: (@pg.new_record? ? '' : "if (!confirm('Are you sure you want to change the name of this page? Any bookmarks or links to this page will no longer work if you proceed with this change.')) { this.value = $('original_name').value; };") %><br/>
      <%= text_field_tag :original_name, @pg.name, style: 'display: none' %>
      <%= text_field :pg, :parent_id, style: 'display: none' %>
    </td>
  </tr>
<%- end -%>
  <tr id="cms_page-form-parent_id-row" style="display: none;">
    <td class="imagine-cms-properties-form__label">Parent Page ID:</td>
    <td><%= text_field :pg, :parent_id, class: 'form', style: 'width: 100%;' %></td>
  </tr>
  <script>
    let nameRow = document.getElementById("cms_page-form-name-row");
    let parentIdRow = document.getElementById("cms_page-form-parent_id-row");
    if (nameRow && parentIdRow) nameRow.addEventListener("click", (e) => { if (e.altKey) { parentIdRow.style.display = "table-row"; } });
  </script>
  <tr>
    <td class="imagine-cms-properties-form__label">Page Title:</td>
    <td><%= text_field :pg, :title, class: 'form', style: 'width: 100%;' %></td>
  </tr>
  <%- if @pg.respond_to?(:redirect_enabled) -%>
  <tr>
    <td class="imagine-cms-properties-form__label">Page Type:</td>
    <td>
      <%= radio_button :pg, :redirect_enabled, false %> Normal
      <%= radio_button :pg, :redirect_enabled, true %> Redirect to:
      <%= text_field :pg, :redirect_to %>
      <%= select :pg, :redirect_status_code, options_for_select([ [ '301 Moved Permanently', 301 ], [ '302 Found', 302 ] ], @pg.redirect_status_code), {}, style: 'margin-left: 10px; width: 55px;' %>
      <script type="text/javascript">
        jQuery('#pg_redirect_enabled_false').click(function () {
          jQuery('#pg_redirect_to').prop('disabled', true);
          jQuery('#pg_redirect_status_code').hide()
          jQuery('#dlg-page-properties tr.page-field').show();
        });
        jQuery('#pg_redirect_enabled_true').click(function () {
          jQuery('#pg_redirect_to').prop('disabled', false);
          jQuery('#pg_redirect_status_code').show();
          jQuery('#dlg-page-properties tr.page-field').hide();
        });
        jQuery('#pg_redirect_enabled_<%= @pg.redirect_enabled == true %>').trigger('click');
      </script>
    </td>
  </tr>
  <%- end -%>
  <tr class="page-field">
    <td class="imagine-cms-properties-form__label" valign="top"><div style="margin-top: 4px;">Template:</div></td>
    <td>
      <%= select :pg, :cms_template_id, CmsTemplate.order(:name).map { |t| [ t.name, t.id ] }, {}, class: 'form', style: 'width: 100%;' %>
      
      <div id="edit_page_template_options">
        <%= render partial: 'template_options' %>
      </div>
    </td>
  </tr>
  <tr>
    <td class="imagine-cms-properties-form__label">Article Date:</td>
    <td>
      <div class="imagine-cms-properties-form__date-row">
        <%= date_field :pg, :article_date,
                       value: (@pg.article_date || @pg.created_on || Time.zone.now).to_date,
                       min: Date.new(2006, 1, 1),
                       max: 5.years.from_now.to_date,
                       class: 'imagine-cms-properties-form__control imagine-cms-properties-form__control--date' %>
        <span id="div_article_end_date" class="imagine-cms-properties-form__date-range"<%= @pg.article_end_date && @pg.article_date != @pg.article_end_date ? '' : ' hidden'.html_safe %>>
          &ndash;
          <%= date_field :pg, :article_end_date,
                         value: (@pg.article_end_date || @pg.article_date || @pg.created_on || Time.zone.now).to_date,
                         min: Date.new(2006, 1, 1),
                         max: 5.years.from_now.to_date,
                         class: 'imagine-cms-properties-form__control imagine-cms-properties-form__control--date' %>
        </span>
        <label class="imagine-cms-properties-form__check">
          <input type="checkbox" id="use_article_date_range" name="use_article_date_range" value="1"<%= @pg.article_end_date && @pg.article_date != @pg.article_end_date ? ' checked="checked"'.html_safe : '' %>>
          Use date range
        </label>
      </div>
      <script>
        document.getElementById("use_article_date_range").addEventListener("change", function (event) {
          document.getElementById("div_article_end_date").hidden = !event.target.checked;
        });
      </script>
    </td>
  </tr>
  <tr>
    <td class="imagine-cms-properties-form__label" valign="middle">Tags:</td>
    <td><%= text_field_tag :tags, @tags, class: 'form', style: 'width: 100%' %></td>
  </tr>
  <tr class="page-field">
    <td class="imagine-cms-properties-form__label">Publish Version:</td>
    <td><%= select :pg, :published_version, [ [ '[ None (offline) ]', -1 ], [ '[ Latest ]', 0 ] ].concat(@pg.versions.reverse.map { |pg| [ "#{pg.version} - #{ts_to_str pg.updated_on}#{" by #{pg.updated_by_username}" unless pg.updated_by_username.blank? }", pg.version ] }), {}, class: 'form', style: 'width: 100%' %></td>
  </tr>
  <tr>
    <td class="imagine-cms-properties-form__label">Publish Date:</td>
    <td>
      <div class="imagine-cms-properties-form__date-row">
        <%= date_field :pg, :published_date,
                       value: (@pg.published_date || @pg.created_on || Time.zone.now).to_date,
                       min: Date.new(2006, 1, 1),
                       max: 2.years.from_now.to_date,
                       class: 'imagine-cms-properties-form__control imagine-cms-properties-form__control--date' %>
        <label class="imagine-cms-properties-form__inline-label" for="pg_position">Position:</label>
        <%= text_field :pg, :position, class: 'form imagine-cms-properties-form__control imagine-cms-properties-form__control--position' %>
      </div>
    </td>
  </tr>
  <tr>
    <td class="imagine-cms-properties-form__label">Expiration Date:</td>
    <td>
      <div class="imagine-cms-properties-form__date-row">
        <label class="imagine-cms-properties-form__check">
          <%= check_box :pg, :expires, {}, 'true', 'false' %>
          Expires on:
        </label>
        <%= date_field :pg, :expiration_date,
                       value: (@pg.expiration_date || @pg.published_date || Time.zone.now).to_date,
                       min: Date.new(2006, 1, 1),
                       max: 2.years.from_now.to_date,
                       class: 'imagine-cms-properties-form__control imagine-cms-properties-form__control--date' %>
      </div>
    </td>
  </tr>
  <tr class="page-field">
    <td class="imagine-cms-properties-form__label" valign="top"><div style="margin-top: 4px;">Summary:</div></td>
    <td><%= text_area :pg, :summary, class: 'form', style: 'width: 100%; height: 50px;' %></td>
  </tr>
  <tr>
    <td class="imagine-cms-properties-form__label" style="vertical-align: top;">Thumbnail:</td>
    <td>
      <%- if @pg.new_record? -%>
        A thumbnail cannot be added until you save this page.
      <%- else -%>
        <div id="thumbnail_preview" style="width: 100%; height: 120px; background: url('<%= @pg.thumbnail_path %>') left top no-repeat; background-size: contain;" onclick="jQuery('#pg_thumbnail_path').toggle();"></div>
        <%= button_to_function "Select Thumbnail...",
                               "selectThumbnail('#{url_for action: 'upload_thumb', id: @pg}');",
                               class: 'imagine-cms-dialog__button' %>
        <%- if @pg.thumbnail_path.present? -%>
          <%= button_to_function "Remove", "jQuery('#thumbnail_preview').css({ 'background-image': 'none' }); jQuery('#pg_thumbnail_path').val(''); jQuery(this).remove();", class: 'imagine-cms-dialog__button' %>
        <%- end -%>
        <%= text_field :pg, :thumbnail_path, class: 'form', style: 'width: 100%; display: none;' %>
      <%- end -%>
    </td>
  </tr>
  <%- if @pg.respond_to?(:feature_image_path) -%>
  <tr>
    <td class="imagine-cms-properties-form__label" style="vertical-align: top;">Feature Image:</td>
    <td>
      <%- if @pg.new_record? -%>
        A feature image cannot be added until you save this page.
      <%- else -%>
        <div id="feature_image_preview" style="width: 100%; height: 120px; background: url('<%= @pg.feature_image_path %>') left top no-repeat; background-size: contain;" onclick="jQuery('#pg_feature_image_path').toggle();"></div>
        <%= button_to_function "Select Feature Image...",
                               "selectThumbnail('#{url_for action: 'upload_feature_image', id: @pg}');",
                               class: 'imagine-cms-dialog__button' %>
        <%- if @pg.feature_image_path.present? -%>
          <%= button_to_function "Remove", "jQuery('#feature_image_preview')..css({ 'background-image': 'none' }); jQuery('#pg_feature_image_path').val(''); jQuery(this).remove();", class: 'imagine-cms-dialog__button' %>
        <%- end -%>
        <%= text_field :pg, :feature_image_path, class: 'form', style: 'width: 100%; display: none;' %>
      <%- end -%>
    </td>
  </tr>
  <%- end -%>
  <%- if @pg.respond_to?(:html_head) -%>
  <tr class="page-field">
    <td class="imagine-cms-properties-form__label" valign="top"><div style="margin-top: 4px;">HTML Head:<br>(advanced)</div></td>
    <td><%= text_area :pg, :html_head, class: 'form', style: 'width: 100%; height: 35px; overflow: auto;' %></td>
  </tr>
  <%- end -%>
  <tr>
    <td class="imagine-cms-properties-form__label" valign="top"><div style="margin-top: 4px;">Custom Attributes:<br>(advanced)</div></td>
    <td>
      <table cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td>Add an attribute: &nbsp;</td>
          <td>
            <div style="position: relative;">
              <%= text_field_tag :custom_attribute_name, '', class: 'form', style: 'margin-bottom: 4px;', placeholder: '[ attribute name ]' %>
              <div id="custom_attribute_name_auto_complete" class="auto_complete" style="display: none;"></div>
              <script type="text/javascript">
                window.addEventListener('DOMContentLoaded', (event) => {
                  $('custom_attribute_name').onkeydown = disableEnterKey;
                  new Autocompleter.Local('custom_attribute_name', 'custom_attribute_name_auto_complete', attrlist, { frequency: 0.1, minChars: 1 });
                });
              </script>

              <%= button_to_function 'Add', "new Ajax.Updater('custom_attributes', '#{url_for(controller: '/manage/cms_pages', action: 'page_attribute')}?name=' + $('custom_attribute_name').value, {asynchronous:true, method:'get', evalScripts:true, insertion:Insertion.Bottom}); $('custom_attribute_name').value = ''; return false;", class: 'imagine-cms-dialog__button', style: 'margin-bottom: 5px;' %>
            </div>
          </td>
        </tr>
      </table>
      <div id="custom_attributes" style="background-color: white; min-height: 40px; overflow: auto; border: 1px solid #aaaaaa">
        <%- @page_objects.to_h.each do |key, val| -%>
          <%- key =~ /^obj-(\w+?)-(.+?)$/ -%>
          <%= render partial: 'page_attribute', locals: { name: $2 } if $1 == 'attribute' %>
        <%- end -%>
      </div>
    </td>
  <tr>
    <td></td>
    <td class="imagine-cms-dialog__actions">
      <%= submit_tag 'Save', id: 'btn_save', class: 'imagine-cms-dialog__button imagine-cms-dialog__button--primary' %>
      <%= link_to_function 'Cancel', "cancelEditProperties();", class: 'imagine-cms-dialog__button imagine-cms-dialog__button--secondary' %>
      <%= hidden_field_tag 'return_to', params[:return_to] %>
    </td>
  </tr>
</table>
<% end -%>
<script type="text/javascript">
  jQuery('#pg_cms_template_id').change(function () {
    jQuery.get('<%= url_for(action: 'show_template_options', id: @pg) %>?template_id=' + jQuery(this).val(), null, function (data) {
      jQuery('#edit_page_template_options').html(data);
    });
  });
</script>

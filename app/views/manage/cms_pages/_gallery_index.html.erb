<div id="images_container">
  <div id="images">
    <%= render partial: 'image', collection: @images, locals: { id: @pg, path: @pg.path, gallery_id: params[:gallery_id] } %>
  </div>
</div>

<%= form_tag({ action: 'gallery_management', id: @pg, gallery_id: params[:gallery_id] }, id: 'mainform_gallery', data: { remote: true, update: 'gallery_container' }) do -%>
  <%= text_field_tag :dirname, '', style: 'display: none' %>
<%- end -%>

<%-
  thumb = "assets/content/#{path}/#{gallery_id}/management/#{image}.jpg"
-%>
<%= link_to image_tag("/#{thumb}?#{File.mtime(File.join(Rails.root, 'public', thumb)).to_i}", size: '90x90'),
            { action: 'image_details', id: id, gallery_id: gallery_id, image: "#{image}.jpg" },
            data: { remote: true, update: 'gallery_window' } %>

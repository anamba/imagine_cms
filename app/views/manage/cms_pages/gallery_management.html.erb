<style type="text/css" media="screen">
  div#controls a {
    color: #4c4c4c;
    font-weight: bold;
    text-decoration: none;
  }
</style>
<div id="gallery_container">
  <div id="controls" style="margin-bottom: 10px;">
    <div id="select_gallery" style="float: left;">
      <%= form_tag({ action: 'select_gallery', id: @pg }, data: { remote: true, update: 'select_gallery' }) do -%>
        Current Gallery:
        <select name="gallery_id" onchange="imagineCmsRemoteFormSubmit(this.form); return false;">
        <%-
          @galleries.each do |gallery|
            unless session[:broken_galleries].include?(File.basename(gallery))
        -%>
          <option value="<%= File.basename(gallery) %>"<%= " selected=\"selected\"" if File.basename(gallery) == params[:gallery_id] %>><%= File.basename(gallery).titleize %></option>
        <%-
            end
          end
        -%>
          <option value="new">New&hellip;</option>
        </select>
      <%- end -%>
    </div>
    
    <%= link_to image_tag("management/gallery_index.gif") + " Index",
                { action: 'gallery_management', id: @pg, gallery_id: params[:gallery_id] },
                style: 'float: right; margin-right: 6px;', data: { remote: true, update: 'gallery_container' } %>
    <%= link_to image_tag("management/gallery_sort.gif") + " Sort images",
                { action: 'sort_images', id: @pg, gallery_id: params[:gallery_id] },
                style: 'float: right; margin-right: 6px;', data: { remote: true, update: 'gallery_window' } %>
    <%= link_to image_tag("management/gallery_delete.gif") + " Delete Gallery",
                { action: 'delete_gallery', id: @pg, gallery_id: params[:gallery_id] },
                style: 'float: right; margin-right: 6px;', data: { remote: true, update: 'delete_gallery_container', confirm: "This gallery, including photos and captions, will be deleted and cannot be undone. Continue?" } %>
    <br clear="all" />
  </div>
  
  <fieldset style="margin-bottom: 10px;">
    <legend>Gallery Settings</legend>

    <%= form_tag({ action: 'save_gallery_settings', id: @pg, gallery_id: params[:gallery_id] }, data: { remote: true, loading: "document.getElementById('btn_save_settings').disabled = true; document.getElementById('btn_save_settings').value = 'Saving...';", failure: "document.getElementById('btn_save_settings').disabled = false; document.getElementById('btn_save_settings').value = 'Save Failed';", success: "document.getElementById('btn_save_settings').value = 'Saved';" }) do %>
    <table>
      <tr>
        <td width="100">Slideshow Speed:</td>
        <td>
          <%= text_field :gallery, :slide_duration, :class => 'form', :style => 'margin-bottom: 0; width: 20px', :onkeypress => "document.getElementById('btn_save_settings').disabled = false;" %> seconds per slide (set to zero to disable)
        </td>
      </tr>
      <tr>
        <td width="100">Slideshow Autoplay?</td>
        <td>
          <%= radio_button :gallery, :autoplay, 'true', :onclick => "document.getElementById('btn_save_settings').disabled = false;" %> <label for="gallery_autoplay_true">Yes</label><br/>
          <%= radio_button :gallery, :autoplay, 'false', :onclick => "document.getElementById('btn_save_settings').disabled = false;" %> <label for="gallery_autoplay_false">No</label>
        </td>
      </tr>
      <tr>
        <td>Show Thumbnails?</td>
        <td><%= @gallery.show_thumbs %>
          <%= radio_button :gallery, :show_thumbs, 'true', :onclick => "document.getElementById('btn_save_settings').disabled = false;" %> <label for="gallery_show_thumbs_true">Yes</label><br/>
          <%= radio_button :gallery, :show_thumbs, 'false', :onclick => "document.getElementById('btn_save_settings').disabled = false;" %> <label for="gallery_show_thumbs_false">No</label>
        </td>
      </tr>
      <tr>
        <td></td>
        <td>
          <%= submit_tag 'Save', :id => 'btn_save_settings', :class => 'form_button', :style => 'width: 70px;' %>
          <%= javascript_tag "document.getElementById('btn_save_settings').disabled = true;" %>
        </td>
      </tr>
    </table>
    <% end %>
  </fieldset>
  
  <fieldset style="margin-bottom: 10px;">
    <legend>Add Images</legend>
    
    <%= form_tag({ :action => 'add_to_gallery', :id => @pg, :gallery_id => params[:gallery_id] }, multipart: true) do %>
    <table>
      <tr>
        <td width="100">Zip or Image File:</td>
        <td>
          <%= file_field 'gallery_file', 'data', :class => 'form', :style => 'margin-bottom: 0; width: 150px' %><br/>
        </td>
      </tr>
      <tr>
        <td></td>
        <td>
          <div id="upload_status_div" class="error"></div>
          <%= submit_tag 'Next', class: 'form_button', style: 'width: 70px;', data: { disable_with: 'Uploading...' } %>
        </td>
      </tr>
    </table>
    <% end %>
  </fieldset>
  
  <div id="gallery_window">
    <%= render :partial => 'gallery_index' %>
  </div>
</div>

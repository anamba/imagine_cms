<div id="imagine_cms-toolbar" class="imagine-cms-toolbar imagine-cms-toolbar--edit">
  <div class="imagine-cms-toolbar__inner">
    <button type="button" class="imagine-cms-toolbar__button imagine-cms-toolbar__button--primary" data-imagine-save>
      Save
    </button>
    <button type="button" class="imagine-cms-toolbar__button" data-imagine-cancel="<%= "#{@pg.path.blank? ? '' : '/' + @pg.path}/version/#{@pg.version}" %>">
      Cancel
    </button>

    <span class="imagine-cms-toolbar__divider"></span>

    <button type="button" class="imagine-cms-toolbar__button" data-imagine-insert-image="<%= url_for action: 'upload_image', id: @pg.id %>">
      Image
    </button>
    <button type="button" class="imagine-cms-toolbar__button" data-imagine-insert-file="<%= url_for action: 'upload_file', id: @pg.id %>">
      File
    </button>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var toolbar = document.getElementById("imagine_cms-toolbar");
    if (!toolbar) return;

    var saveButton = toolbar.querySelector("[data-imagine-save]");
    var cancelButton = toolbar.querySelector("[data-imagine-cancel]");
    var imageButton = toolbar.querySelector("[data-imagine-insert-image]");
    var fileButton = toolbar.querySelector("[data-imagine-insert-file]");

    if (saveButton) {
      saveButton.addEventListener("click", function () {
        ImagineCms.Editor.submitEditForm();
      });
    }
    if (cancelButton) {
      cancelButton.addEventListener("click", function () {
        ImagineCms.Editor.cancelEdit(cancelButton.dataset.imagineCancel);
      });
    }
    if (imageButton) {
      imageButton.addEventListener("click", function () {
        insertImage(imageButton.dataset.imagineInsertImage);
      });
    }
    if (fileButton) {
      fileButton.addEventListener("click", function () {
        insertFile(fileButton.dataset.imagineInsertFile);
      });
    }
  });
</script>

<script>
  try {
    document.getElementById("insert_image_dialog_content").innerHTML = "";
  } catch (e) { }
</script>

<div id="save_errors" class="error"></div>
<h3>Create Download Link</h3>

<p>Select the file you'd like to make available for site visitors to download.</p>

<%= form_tag({ action: 'receive_file', id: @pg }, { id: 'upload-file-form', multipart: true }) do -%>
<table>
  <tr>
    <td>File:</td>
    <td>
      <%= file_field 'file', 'data', class: 'form', style: 'margin-bottom: 0; min-width: 150px' %>
    </td>
  </tr>
  <tr>
    <td></td>
    <td>
      <div id="upload_status_div" class="error"></div>
      <%= submit_tag 'Finish', class: 'form_button', style: 'width: 70px;', data: { disable_with: 'Uploading...' } %>
      <button type="button" class="form_button" onclick="cancelInsertFile()">Cancel</button>
    </td>
  </tr>
</table>
<%- end -%>

<%= form_tag({ action: 'create_file_link', id: @pg }, { id: 'mainform' }) do -%>
  <%= text_field_tag 'filename', '', :style => 'display: none' %>
<%- end -%>

<script>
  document.getElementById("upload-file-form").addEventListener("submit", async function (event) {
    event.preventDefault();
    var form = event.currentTarget;
    var status = document.getElementById("upload_status_div");
    if (status) status.textContent = "Uploading...";

    var response = await fetch(form.action, {
      method: "POST",
      credentials: "same-origin",
      headers: { "X-CSRF-Token": ImagineCms.Editor.csrfToken() },
      body: new FormData(form)
    });
    var data = await response.json();

    document.getElementById("filename").value = data.filename;
    var linkResponse = await fetch(document.getElementById("mainform").action, {
      method: "POST",
      credentials: "same-origin",
      headers: { "X-CSRF-Token": ImagineCms.Editor.csrfToken() },
      body: new FormData(document.getElementById("mainform"))
    });
    setImagineDialogContent(document.getElementById("insert_file_dialog_content"), await linkResponse.text());
  });
</script>

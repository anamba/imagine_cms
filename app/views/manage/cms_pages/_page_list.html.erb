<%- options ||= {} -%>
<div id="page_list_container_<%= key %>" class="page_list_dialog" style="border: 1px solid gray; padding: 8px; background-color: #dddddd; width: 170px; text-align: center;">
  Page List: <%= name %><br/>
  <button class="form_button" onclick="showDojoDialog('page_list_<%= key %>'); return false;">Configure</button>
</div>
<div id="page_list_<%= key %>" class="imagine-cms-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="page_list_<%= key %>_title">
  <div class="imagine-cms-dialog__panel" style="width: min(620px, 100%); max-height: calc(100vh - 72px);">
    <div class="imagine-cms-dialog__header">
      <h2 id="page_list_<%= key %>_title" data-imagine-dialog-title>Page List: <%= name %></h2>
      <button type="button" class="imagine-cms-dialog__close" onclick="hideDojoDialog('page_list_<%= key %>');" aria-label="Close">×</button>
    </div>
    <div class="imagine-cms-dialog__content" style="max-height: calc(100vh - 132px); overflow: auto;">
  <div class="ccs-page-list-form">
    <fieldset>
      <legend>Sources</legend>
      
      Select folders and/or tags to indicate which content to pull into this list.
      
      <div id="page_list_<%= key %>-source-list" style="margin: 10px;">
        <%- @page_objects["#{key}-sources-folder-count"].to_i.times do |i| -%>
          <%= render partial: 'page_list_source_folder', locals: { i: i, key: key } %>
        <%- end -%>
        <%- @page_objects["#{key}-sources-tag-count"].to_i.times do |i| -%>
          <%= render partial: 'page_list_source_tag', locals: { i: i, key: key } %>
        <%- end -%>
        <%-
          @page_objects["#{key}-sources-tag-count"] ||= 0
          @page_objects["#{key}-sources-folder-count"] ||= 0
        -%>
        <%= text_field :page_objects, "#{key}-sources-tag-count", style: 'display: none;' %>
        <%= text_field :page_objects, "#{key}-sources-folder-count", style: 'display: none;' %>
      </div>
      
      <table>
        <tr>
          <td>
            <button type="button" class="form_button" onclick="
              var count = jQuery('#page_objects_<%= key %>-sources-folder-count').val();
              var token = jQuery('meta[name=csrf-token]').attr('content');
              jQuery.ajax({
                url: '/manage/cms_pages/page_list_add_folder',
                type: 'POST',
                data: { key: '<%= key %>', i: count },
                headers: { 'X-CSRF-Token': token },
                success: function(html) {
                  jQuery('#page_list_<%= key %>-source-list').append(html);
                  jQuery('#page_objects_<%= key %>-sources-folder-count').val(parseInt(count) + 1);
                }
              });
              return false;
            ">Add Page/Folder</button>
          </td>
          <td>
            <button type="button" class="form_button" onclick="
              var count = jQuery('#page_objects_<%= key %>-sources-tag-count').val();
              var token = jQuery('meta[name=csrf-token]').attr('content');
              jQuery.ajax({
                url: '/manage/cms_pages/page_list_add_tag',
                type: 'POST',
                data: { key: '<%= key %>', i: count },
                headers: { 'X-CSRF-Token': token },
                success: function(html) {
                  jQuery('#page_list_<%= key %>-source-list').append(html);
                  jQuery('#page_objects_<%= key %>-sources-tag-count').val(parseInt(count) + 1);
                }
              });
              return false;
            ">Add Tag</button>
          </td>
          <td>
            <label>
              <%= check_box :page_objects, "#{key}-include-expired", {}, 'true', 'false' %>
              Include expired items
            </label>
            &nbsp;
          </td>
          <td>
            <label>
              <%= check_box :page_objects, "#{key}-exclude-current", {}, 'true', 'false' %>
              Exclude current page
            </label>
          </td>
        </tr>
      </table>
    </fieldset>
    
    <fieldset>
      <legend>Display</legend>
      
      <table>
        <col width="60" />
        <tr>
          <td>Format:</td>
          <td colspan="2">
            <%- @page_objects["#{key}-style-display-as"] ||= 'list' -%>
            <label>
              <%= radio_button :page_objects, "#{key}-style-display-as", 'list' %>
              List
            </label>&nbsp;
            <label>
              <%= radio_button :page_objects, "#{key}-style-display-as", 'calendar' %>
              Calendar
            </label>
          </td>
        </tr>
        <tr class="page_list_<%= key %>_list_option">
          <td valign="top"><div style="margin-top: 2px;">Number:</div></td>
          <td>
            Display <%= text_field :page_objects, "#{key}-max-item-count", placeholder: options[:item_count].to_s, class: 'form', style: 'margin: 0; width: 20px;' %> items,
            but skip the first <%= text_field :page_objects, "#{key}-item-offset", placeholder: (options[:item_offset] || 0).to_s, class: 'form', style: 'margin: 0; width: 20px;' %>
            <br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <label>
              <%= check_box :page_objects, "#{key}-use-pagination" %>
              Show multiple list segments
            </label>
            <br>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <label>
              <%= check_box :page_objects, "#{key}-use-randomization" %>
              Select randomly from the top
              <%= text_field(:page_objects, "#{key}-random-pool-size", class: 'form', style: 'margin: 0; width: 20px') %> items
            </label>
          </td>
        </tr>
        <tr class="page_list_<%= key %>_list_option">
          <td>Sort Order:</td>
          <td>
            First by
            <%= select(:page_objects, "#{key}-sort-first-field",
                       [ [ 'Date', 'article_date' ], [ 'Position', 'position' ],
                         [ 'Title', 'title' ] ], {},
                       :class => 'form', :style => 'margin: 0; border: 1px solid gray;') %>
            <%= select(:page_objects, "#{key}-sort-first-direction",
                       [ 'asc', 'desc' ], {},
                       :class => 'form', :style => 'margin: 0; border: 1px solid gray;') %>
            then by
            <%= select(:page_objects, "#{key}-sort-second-field",
                       [ [ 'Date', 'article_date' ], [ 'Position', 'position' ],
                         [ 'Title', 'title' ] ], {},
                       :class => 'form', :style => 'margin: 0; border: 1px solid gray;') %>
            <%= select(:page_objects, "#{key}-sort-second-direction",
                       [ 'asc', 'desc' ], {},
                       :class => 'form', :style => 'margin: 0; border: 1px solid gray;') %>
          </td>
        <tr class="page_list_<%= key %>_list_option">
          <td>Dates:</td>
          <td>
            <%-
              @page_objects["#{key}-date-range"] ||= 'all'
              start_val = @page_objects["#{key}-date-range-custom-start"]
              end_val = @page_objects["#{key}-date-range-custom-end"]
              start_date = if start_val.is_a?(String)
                             Date.parse(start_val) rescue Date.today
                           else
                             start_val || Date.today
                           end
              end_date = if end_val.is_a?(String)
                           Date.parse(end_val) rescue Date.today
                         else
                           end_val || Date.today
                         end
            -%>
            <label>
              <%= radio_button :page_objects, "#{key}-date-range", 'all' %>
              All Dates
            </label>&nbsp;
            <label>
              <%= radio_button :page_objects, "#{key}-date-range", 'past' %>
              Past
            </label>&nbsp;
            <label>
              <%= radio_button :page_objects, "#{key}-date-range", 'future' %>
              Future
            </label>&nbsp;
            <label>
              <%= radio_button :page_objects, "#{key}-date-range", 'custom' %>
              Range:
              <%= text_field_tag "page_objects[#{key}-date-range-custom-start]", start_date.strftime('%Y-%m-%d'), class: 'form', style: 'margin: 0; padding: 2px;', type: 'date' %> &ndash;
              <%= text_field_tag "page_objects[#{key}-date-range-custom-end]", end_date.strftime('%Y-%m-%d'), class: 'form', style: 'margin: 0; padding: 2px;', type: 'date' %>
            </label>
          </td>
        </tr>
      </table>
    </fieldset>
    
    <fieldset>
      <legend>Item Template</legend>
      
      <div style="float: left; width: 330px;">
        This HTML code will be generated for each page in the source list. Customize it with attributes (e.g. Title).
      </div>
      
      <div style="float: right">
        <%-
          system_attrs = {
            'article_date_month'  => 'Article Date - Month',
            'article_date_mon'    => 'Article Date - Month Abbr',
            'article_date_day'    => 'Article Date - Day',
            'article_date_year'   => 'Article Date - Year',
            'article_date_yr'     => 'Article Date - Year Abbr',
            'tags'                => 'Tags',
            'tags_as_css_classes' => 'Tags as CSS Classes',
          }
          @pg.attributes.each do |attr, value|
            next if [ 'cms_template_id', 'cms_template_version' ].include?(attr)
            system_attrs[attr] ||= attr.titleize
          end
        -%>
        <select class="form" style="width: 150px;" onchange="insertAtCaret(document.getElementById('page_objects_<%= key %>-template'), '<# ' + this.value + ' #>'); this.value = '';">
          <option value="">-- Insert Attribute --</option>
          <%- system_attrs.sort.each do |attr, label| -%>
            <option value="<%= attr %>"><%= label %></option>
          <%- end -%>
        </select>
      </div>
      
      <br clear="all">
      
      <%= text_area :page_objects, "#{key}-template", placeholder: options[:template].to_s.gsub(/\s+/, ' '), style: 'border: 1px solid gray; width: 100%; padding: 8px;', rows: '6' %>
    </fieldset>
    
    <div id="page_list_<%= key %>-advanced">
      <fieldset>
        <legend>Enclosing HTML</legend>
        
        <table width="100%">
          <tr>
            <td valign="top">Before:</td>
            <td><%= text_area :page_objects, "#{key}-header", placeholder: options[:header].to_s.gsub(/\s+/, ' '), style: 'border: 1px solid gray; width: 100%; min-height: 32px; padding: 8px;' %></td>
          </tr>
          <tr>
            <td valign="top">After:</td>
            <td><%= text_area :page_objects, "#{key}-footer", placeholder: options[:footer].to_s.gsub(/\s+/, ' '), style: 'border: 1px solid gray; width: 100%; min-height: 32px; padding: 8px;' %></td>
          </tr>
        </table>
      </fieldset>
      
      <fieldset>
        <legend>"Empty" Message</legend>
        
        <p>This message is displayed when no pages match the search criteria.</p>
        
        <%= text_area :page_objects, "#{key}-empty_message", placeholder: options[:empty_message].to_s.gsub(/\s+/, ' '), style: 'border: 1px solid gray; width: 100%; min-height: 32px; padding: 8px;' %>
      </fieldset>
    </div>
    
    <br>
    
    <center><button class="form_button" onclick="hideDojoDialog('page_list_<%= key %>'); return false;">Close</button></center>
  </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  window.addEventListener('DOMContentLoaded', (event) => {
    var displayAsList = jQuery('#page_objects_<%= key %>-style-display-as_list').checked;
    jQuery('.page_list_<%= key %>_list_option').toggle(displayAsList);
    jQuery('.page_list_<%= key %>_calendar_option').toggle(!displayAsList);

    jQuery('#page_list_<%= key %>').appendTo(jQuery('#page_content_form')[0]);
    jQuery('#page_objects_<%= key %>-style-display-as_list').click(function () {
      jQuery('.page_list_<%= key %>_list_option').show();
      jQuery('.page_list_<%= key %>_calendar_option').hide();
    });
    jQuery('#page_objects_<%= key %>-style-display-as_calendar').click(function () {
      jQuery('.page_list_<%= key %>_list_option').hide();
      jQuery('.page_list_<%= key %>_calendar_option').show();
    });
  });
</script>

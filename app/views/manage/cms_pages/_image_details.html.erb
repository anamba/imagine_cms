<%- img = "assets/content/#{@pg.path}/#{params[:gallery_id]}/#{params[:image]}" -%>
<table>
  <tr valign="top">
    <td><%= image_tag "/#{img}?#{File.mtime(File.join(Rails.root, 'public', img)).to_i}" %></td>
    <td style="padding-left: 10px;">
      <div id="caption_container" style="margin-bottom: 20px;">
        <strong>Caption</strong><br/>
        <%= form_tag({ action: 'update_caption', id: params[:id], gallery_id: params[:gallery_id], image: params[:image] }, data: { remote: true, update: 'gallery_container' }) do -%>
          <%= text_area_tag "caption", @caption %><br/>
          <%= submit_tag "Save" %> or <%= link_to "cancel",
                                                  { action: 'gallery_management', id: params[:id], gallery_id: params[:gallery_id] },
                                                  data: { remote: true, update: 'gallery_container' } %>
        <%- end -%>
      </div>
      
      <div id="delete_container">
        <strong>Delete Photo</strong><br/>
        <%= form_tag({ action: 'delete_photo', id: params[:id], gallery_id: params[:gallery_id], image: params[:image] }, data: { remote: true, update: 'gallery_container', confirm: "This action cannot be undone. Continue?" }) do -%>
          <%= submit_tag "Delete" %>
        <%- end -%>
      </div>
    </td>
  </tr>
</table>
